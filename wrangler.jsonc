{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "iaipi-web",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// Alamat publik situs. Passkey admin hanya berlaku di domain tempat passkey
	// itu dibuat, jadi isi ini SEBELUM setup admin pertama kalau setup dilakukan
	// langsung di domain produksi. Saat uji coba di *.workers.dev, biarkan
	// dikomentari lalu pindahkan lewat Settings > General > Change domain.
	// "vars": {
	// 	"EMDASH_SITE_URL": "https://iaipersisgarut.ac.id"
	// },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "iaipi-web"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "iaipi-web-media"
		}
	],
	// Plugin sandbox EmDash butuh Worker Loader (khusus paket Workers Paid).
	// Aktifkan baris ini + sandboxRunner di astro.config.mjs bila sudah upgrade:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// Cron untuk publikasi terjadwal, backup, dan pemeliharaan EmDash.
	"triggers": {
		"crons": ["* * * * *"]
	},
	// Aktifkan setelah DNS iaipersisgarut.ac.id dipindah ke Cloudflare:
	// "routes": [
	// 	{ "pattern": "iaipersisgarut.ac.id", "custom_domain": true },
	// 	{ "pattern": "www.iaipersisgarut.ac.id", "custom_domain": true }
	// ],
	"observability": {
		"enabled": true
	}
}
