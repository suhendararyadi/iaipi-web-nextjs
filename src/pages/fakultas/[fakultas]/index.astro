---
// Halaman satu fakultas S1: /fakultas/<slug>.
import { decodeSlug } from "emdash";
import Base from "@/layouts/Base.astro";
import PageBanner from "@/components/layout/PageBanner.astro";
import FakultasDetail from "@/components/akademik/FakultasDetail.astro";
import { mediaSrc, useCacheHint } from "@/lib/cms";
import { getFakultas, getProdiList, kalimatPertama } from "@/lib/akademik";

const slug = decodeSlug(Astro.params.fakultas);
if (!slug) return Astro.rewrite("/404");

const { entry, cacheHint } = await getFakultas(slug);
if (!entry) return Astro.rewrite("/404");
// Entri pascasarjana (S2) ditampilkan di /magister.
if (entry.data.jenjang === "S2") return Astro.redirect("/magister", 301);

const prodi = await getProdiList();
useCacheHint(Astro, cacheHint, prodi.cacheHint);

const f = entry.data;
const list = prodi.entries.filter((p) => p.data.jenjang !== "S2" && p.data.fakultas === entry.id);
---

<Base
	title={f.nama}
	description={f.deskripsi_singkat || kalimatPertama(f.deskripsi)}
	content={{ collection: "fakultas", id: f.id, slug }}
>
	<PageBanner
		title={f.nama}
		backgroundImage={mediaSrc(f.gambar_banner, "/images/page-banner-1.jpg")}
		breadcrumbs={[{ text: "Home", url: "/" }, { text: "Fakultas", url: "/fakultas" }, { text: f.nama }]}
	/>
	<section class="container pt-70 pb-70">
		<FakultasDetail fakultas={entry} prodi={list} />
	</section>
</Base>
