---
// Program Pascasarjana (S2): isi dari entri fakultas jenjang S2 + prodi jenjang S2.
import Base from "@/layouts/Base.astro";
import PageBanner from "@/components/layout/PageBanner.astro";
import FakultasDetail from "@/components/akademik/FakultasDetail.astro";
import { mediaAlt, mediaSrc, useCacheHint } from "@/lib/cms";
import { getFakultasList, getProdiList, kalimatPertama } from "@/lib/akademik";

const [fak, prodi] = await Promise.all([getFakultasList(), getProdiList()]);
useCacheHint(Astro, fak.cacheHint, prodi.cacheHint);

const pasca = fak.entries.find((f) => f.data.jenjang === "S2");
const list = prodi.entries.filter((p) => p.data.jenjang === "S2");
const banner = mediaSrc(pasca?.data.gambar_banner);
---

<Base
	title="Program Magister (S2)"
	description={pasca?.data.deskripsi_singkat || kalimatPertama(pasca?.data.deskripsi) || "Program Magister (S2) Institut Agama Islam PERSIS Garut."}
	content={pasca ? { collection: "fakultas", id: pasca.data.id, slug: pasca.id } : undefined}
>
	<PageBanner
		title="Program Magister (S2)"
		image={banner || "/images/page-banner-7.jpg"}
		imageAlt={banner ? mediaAlt(pasca?.data.gambar_banner, pasca?.data.nama ?? "") : ""}
		badge={pasca ? `${pasca.data.nama} · ${list.length} Program Magister` : undefined}
		summary={pasca?.data.deskripsi_singkat}
		breadcrumbs={[{ text: "Beranda", url: "/" }, { text: "Program Magister" }]}
	/>
	{
		pasca ? (
			<FakultasDetail fakultas={pasca} prodi={list} />
		) : (
			<section class="section">
				<div class="wadah">
					<p class="kosong">Belum ada data Program Pascasarjana.</p>
				</div>
			</section>
		)
	}
</Base>
