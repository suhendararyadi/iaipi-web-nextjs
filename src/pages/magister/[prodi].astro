---
// Detail prodi S2: /magister/<prodi>.
import { decodeSlug } from "emdash";
import Base from "@/layouts/Base.astro";
import ProdiDetail from "@/components/akademik/ProdiDetail.astro";
import { mediaSrc, useCacheHint } from "@/lib/cms";
import { getFakultas, getKaprodiProfil, getProdi, kalimatPertama } from "@/lib/akademik";

const slug = decodeSlug(Astro.params.prodi);
if (!slug) return Astro.rewrite("/404");

const { entry, cacheHint } = await getProdi(slug);
if (!entry || entry.data.jenjang !== "S2") return Astro.rewrite("/404");

const [fak, kap] = await Promise.all([getFakultas(entry.data.fakultas), getKaprodiProfil(entry.data.kaprodi_slug)]);
useCacheHint(Astro, cacheHint, fak.cacheHint, kap.cacheHint);

const p = entry.data;
const gambar = mediaSrc(p.gambar_banner) || mediaSrc(p.gambar);
---

<Base
	title={p.judul_seo || `${p.nama} (${p.singkatan})`}
	description={p.deskripsi_seo || p.deskripsi_singkat || kalimatPertama(p.deskripsi)}
	image={gambar ? new URL(gambar, Astro.url).href : null}
	content={{ collection: "prodi", id: p.id, slug }}
>
	<ProdiDetail prodi={entry} fakultas={fak.entry} kaprodi={kap.kaprodi} />
</Base>
