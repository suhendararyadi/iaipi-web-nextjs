---
// Layout dasar semua halaman publik: CSS tema lama, header, footer, navigasi
// bawah (mobile), tombol WhatsApp, dan skrip jQuery tema (slider, counter, dll).
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import BottomNav from "@/components/layout/BottomNav.astro";
import WhatsAppFloat from "@/components/layout/WhatsAppFloat.astro";
import { getInfoKampus, mediaSrc, useCacheHint } from "@/lib/cms";

interface Props {
	/** Judul halaman (tanpa nama situs). Kosongkan untuk beranda. */
	title?: string;
	description?: string | null;
	/** Path kanonis, mis. "/pimpinan". Default: path halaman ini. */
	canonical?: string | null;
	/** URL gambar Open Graph. */
	image?: string | null;
	/** Isi bila halaman merender satu entri CMS (untuk panel SEO & visual editing). */
	content?: { collection: string; id: string; slug?: string | null };
	pageType?: "website" | "article";
}

const { title, description, canonical, image, content, pageType = "website" } = Astro.props;

const [settingsResult, menuResult, footerSitemap, footerLayanan, infoResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("utama"),
	getMenuWithCacheHint("footer_sitemap"),
	getMenuWithCacheHint("footer_layanan"),
	getInfoKampus(),
]);
useCacheHint(
	Astro,
	settingsResult.cacheHint,
	menuResult.cacheHint,
	footerSitemap.cacheHint,
	footerLayanan.cacheHint,
	infoResult.cacheHint,
);

const info = infoResult.info;
const siteTitle = settingsResult.data?.title || info.nama;
const fullTitle = title ? `${title} | ${info.nama_singkat || siteTitle}` : `${siteTitle} | ${settingsResult.data?.tagline ?? ""}`.replace(/ \| $/, "");
const pageDescription = description || info.deskripsi || settingsResult.data?.tagline || null;
const logo = mediaSrc(info.logo, "/images/logo.jpeg");
const ogImage = image || new URL(logo, Astro.url).href;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType,
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: pageDescription,
	canonical: canonicalUrl,
	image: ogImage,
	content,
	siteName: siteTitle,
});

const organizationJsonLd = {
	"@context": "https://schema.org",
	"@type": "EducationalOrganization",
	name: info.nama,
	alternateName: info.nama_singkat,
	url: (Astro.site ?? Astro.url).origin,
	logo: new URL(logo, Astro.site ?? Astro.url).href,
	description: info.deskripsi,
	address: {
		"@type": "PostalAddress",
		streetAddress: info.alamat,
		addressLocality: info.kota,
		addressRegion: info.provinsi,
		postalCode: info.kode_pos,
		addressCountry: "ID",
	},
	telephone: info.telepon,
	email: info.email,
	sameAs: [info.facebook, info.instagram, info.youtube].filter(Boolean),
};

const gaId = info.google_analytics_id?.trim();
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<link rel="stylesheet" href="/css/font-awesome.min.css" />
		<link rel="stylesheet" href="/css/bootstrap.min.css" />
		<link rel="stylesheet" href="/css/slick.css" />
		<link rel="stylesheet" href="/css/magnific-popup.css" />
		<link rel="stylesheet" href="/css/style.css" />
		<link rel="stylesheet" href="/css/default.css" />
		<link rel="stylesheet" href="/css/header3.css" />
		<link rel="stylesheet" href="/css/tabs.css" />
		<link rel="stylesheet" href="/css/custom.css" />
		<link rel="stylesheet" href="/css/slider-fix.css" />
		<link rel="stylesheet" href="/css/header-islamic-v3.css" />
		<link rel="stylesheet" href="/css/site.css" />
		<slot name="head" />

		<EmDashHead page={pageCtx} />
		<script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />

		{
			gaId && (
				<>
					<script async src={`https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaId)}`} />
					<script is:inline define:vars={{ gaId }}>
						window.dataLayer = window.dataLayer || [];
						function gtag() {
							dataLayer.push(arguments);
						}
						gtag("js", new Date());
						gtag("config", gaId);
					</script>
				</>
			)
		}
	</head>

	<body>
		<EmDashBodyStart page={pageCtx} />
		<a href="#main-content" class="skip-link">Langsung ke konten utama</a>

		<div class="preloader">
			<div class="loader rubix-cube">
				<div class="layer layer-1"></div>
				<div class="layer layer-2"></div>
				<div class="layer layer-3"></div>
				<div class="layer layer-4"></div>
				<div class="layer layer-5"></div>
				<div class="layer layer-6"></div>
				<div class="layer layer-7"></div>
				<div class="layer layer-8"></div>
			</div>
		</div>

		<Header info={info} logo={logo} menu={menuResult.data} />

		<main id="main-content">
			<slot />
		</main>

		<Footer info={info} logo={logo} sitemap={footerSitemap.data} layanan={footerLayanan.data} />
		<BottomNav siakadUrl={info.link_siakad} />

		<a href="#" class="back-to-top" aria-label="Kembali ke atas"><i class="fa fa-angle-up"></i></a>
		<WhatsAppFloat info={info} />

		<script is:inline src="/js/vendor/jquery-1.12.4.min.js"></script>
		<script is:inline src="/js/bootstrap.min.js"></script>
		<script is:inline src="/js/slick.min.js"></script>
		<script is:inline src="/js/waypoints.min.js"></script>
		<script is:inline src="/js/jquery.counterup.min.js"></script>
		<script is:inline src="/js/jquery.nice-select.min.js"></script>
		<script is:inline src="/js/jquery.magnific-popup.min.js"></script>
		<script is:inline src="/js/main.js"></script>
		<slot name="scripts" />

		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
