---
// Satu panel tab rincian biaya (S1 atau S2): tabel komponen + panel ringkasan hijau.
import type { BarisBiaya } from "@/lib/profil";
import { tanpaBintang, biayaSemester } from "@/lib/profil";
import TombolPil from "@/components/profil/TombolPil.astro";

interface Props {
	id: string;
	tabId: string;
	aktif: boolean;
	judul: string;
	subjudul?: string | null;
	tahun?: string | null;
	baris: BarisBiaya[];
	catatan?: string | null;
	daftar: string;
	wa: string;
}

const { id, tabId, aktif, judul, subjudul, tahun, baris, catatan, daftar, wa } = Astro.props;
const semester = biayaSemester(baris);
const LABEL_BAYAR = { sekali: "Sekali bayar", semester: "Tiap semester" } as const;
---

<div class="panel" role="tabpanel" id={id} aria-labelledby={tabId} hidden={!aktif} tabindex="0">
	<div class="utama">
		<div class="kepala">
			<h3>{judul}</h3>
			{tahun && <span class="pil-ta">TA {tahun}</span>}
		</div>
		{subjudul && <p class="sub">{subjudul}</p>}
		<table class="tabel-biaya">
			<caption class="sr-only">Rincian biaya {judul}</caption>
			<thead>
				<tr>
					<th scope="col">Komponen biaya</th>
					<th scope="col">Pembayaran</th>
					<th scope="col">Nominal</th>
				</tr>
			</thead>
			<tbody>
				{
					baris.map((b) => (
						<tr>
							<th scope="row">
								<span class="komponen">{b.label}</span>
								{b.sub && <span class="ket">{b.sub}</span>}
							</th>
							<td data-label="Pembayaran">{b.frekuensi && <span class:list={["bayar", b.frekuensi]}>{LABEL_BAYAR[b.frekuensi]}</span>}</td>
							<td class="nominal">{b.nominal}</td>
						</tr>
					))
				}
			</tbody>
		</table>
		<p class="legenda">* dibayar sekali &nbsp;·&nbsp; ** dibayar tiap semester &nbsp;·&nbsp; biaya dapat dicicil sesuai ketentuan</p>
	</div>
	<aside class="ringkas" aria-label={`Ringkasan biaya ${judul}`}>
		<span class="cincin" aria-hidden="true"></span>
		{
			semester && (
				<>
					<p class="ringkas-label">{tanpaBintang(semester.label)}</p>
					<p class="ringkas-nilai">{semester.nominal}</p>
					<p class="ringkas-ket">dibayar tiap semester, dapat dicicil sesuai ketentuan</p>
					<hr />
				</>
			)
		}
		{catatan && <p class="ringkas-catatan">{catatan}</p>}
		<div class="ringkas-aksi">
			<TombolPil href={daftar} ikon="arrow-right" besar lebar>Daftar Online</TombolPil>
			<TombolPil href={wa} varian="krem" ikon="none" besar lebar>Tanya Rincian Biaya</TombolPil>
		</div>
	</aside>
</div>

<style>
	.panel {
		margin-top: 60px;
		padding: clamp(22px, 3.4vw, 40px);
		border-radius: var(--radius-xl);
		background: var(--putih);
		border: 1px solid #eef0ee;
		box-shadow: 0 8px 24px rgba(3, 51, 29, 0.07);
		display: flex;
		flex-wrap: wrap;
		gap: 36px 44px;
	}
	.panel:not([hidden]) {
		display: flex;
	}
	.utama {
		flex: 1 1 520px;
		min-width: 0;
	}
	.kepala {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 16px;
		align-items: center;
		justify-content: space-between;
	}
	h3 {
		font-weight: 800;
		font-size: clamp(24px, 2.4vw, 30px);
		line-height: 1.2;
	}
	.pil-ta {
		display: inline-block;
		padding: 5px 14px;
		border-radius: 999px;
		border: 1px solid var(--kuning);
		background: var(--krem);
		font-family: var(--font-ui);
		font-weight: 700;
		font-size: 13px;
		line-height: 1.4;
		color: var(--judul);
	}
	.sub {
		margin-top: 8px;
		font-size: 16px;
		letter-spacing: 0.3px;
		color: var(--redup);
	}
	.tabel-biaya {
		width: 100%;
		margin-top: 24px;
		border-collapse: collapse;
	}
	thead th {
		padding: 0 0 12px;
		border-bottom: 2px solid var(--hijau);
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 12.5px;
		line-height: 1.3;
		letter-spacing: 1px;
		color: var(--redup);
		text-transform: uppercase;
		text-align: left;
	}
	thead th:nth-child(2) {
		width: 148px;
	}
	thead th:last-child {
		width: 150px;
		text-align: right;
	}
	tbody th,
	tbody td {
		padding: 16px 0;
		border-bottom: 1px solid var(--garis);
		text-align: left;
		vertical-align: middle;
		font-weight: 400;
	}
	tbody td:first-of-type {
		padding-left: 12px;
	}
	.komponen {
		display: block;
		font-size: 17px;
		font-weight: 600;
		line-height: 1.35;
		color: var(--judul);
	}
	.ket {
		display: block;
		margin-top: 2px;
		font-size: 14px;
		line-height: 1.4;
		letter-spacing: 0.2px;
		color: var(--redup);
	}
	.bayar {
		display: inline-block;
		padding: 4px 12px;
		border-radius: 999px;
		background: var(--abu);
		font-family: var(--font-ui);
		font-weight: 700;
		font-size: 13px;
		line-height: 1.4;
		color: var(--hijau-tua);
		white-space: nowrap;
	}
	.bayar.semester {
		padding: 3px 11px;
		border: 1px solid var(--kuning);
		background: var(--krem);
		color: var(--judul);
	}
	.nominal {
		text-align: right !important;
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
		color: var(--hijau);
		white-space: nowrap;
	}
	.legenda {
		margin-top: 16px;
		font-size: 14px;
		letter-spacing: 0.2px;
		color: var(--redup);
	}

	.ringkas {
		flex: 0 1 330px;
		min-width: 0;
		position: relative;
		overflow: hidden;
		padding: 32px 30px;
		border-radius: var(--radius-l);
		background: var(--hijau);
		color: var(--putih);
		display: flex;
		flex-direction: column;
	}
	.ringkas > :not(.cincin) {
		position: relative;
	}
	.cincin {
		position: absolute;
		right: -90px;
		bottom: -110px;
		width: 260px;
		height: 260px;
		border-radius: 50%;
		border: 40px solid rgba(255, 255, 255, 0.07);
	}
	.ringkas-label {
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 13px;
		line-height: 1.3;
		letter-spacing: 1.4px;
		color: var(--hijau-muda);
		text-transform: uppercase;
	}
	.ringkas-nilai {
		margin-top: 10px;
		font-weight: 900;
		font-size: 40px;
		line-height: 1.1;
		letter-spacing: -0.5px;
	}
	.ringkas-ket {
		margin-top: 6px;
		font-size: 15px;
		line-height: 1.4;
		letter-spacing: 0.3px;
		color: var(--hijau-muda);
	}
	.ringkas hr {
		width: 100%;
		border: 0;
		border-top: 1px solid rgba(255, 255, 255, 0.22);
		margin: 22px 0;
	}
	.ringkas-catatan {
		font-size: 16px;
		line-height: 1.55;
		letter-spacing: 0.3px;
	}
	.ringkas-aksi {
		margin-top: auto;
		padding-top: 28px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	@media (max-width: 640px) {
		thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0 0 0 0);
		}
		.tabel-biaya,
		tbody,
		tr {
			display: block;
		}
		tr {
			display: grid;
			grid-template-columns: 1fr auto;
			gap: 8px 12px;
			padding: 14px 0;
			border-bottom: 1px solid var(--garis);
		}
		tr:first-child {
			border-top: 2px solid var(--hijau);
		}
		tbody th,
		tbody td {
			display: block;
			padding: 0;
			border: 0;
		}
		tbody th {
			grid-column: 1 / -1;
		}
		tbody td:first-of-type {
			padding-left: 0;
		}
		.ringkas {
			flex-basis: 100%;
			padding: 28px 22px;
		}
		.ringkas-nilai {
			font-size: 34px;
		}
	}
</style>
