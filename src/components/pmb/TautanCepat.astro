---
// Pita tautan cepat di bawah hero PMB: tiga kartu wordmark (Daftar Online, Rincian Biaya, Admin PMB).
import { linkAttrs } from "@/lib/cms";
import Ikon from "@/components/profil/Ikon.astro";

interface Props {
	daftar: string;
	wa: string;
}

const { daftar, wa } = Astro.props;
---

<section class="pita-cepat" aria-label="Tautan cepat PMB">
	<div class="wadah daftar">
		<a href={daftar} class="kartu-cepat" {...linkAttrs(daftar)}>
			<svg aria-hidden="true" viewBox="0 0 40 40" width="40" height="40" class="toga">
				<path d="M20 7 L37 14.5 L20 22 L3 14.5 Z" fill="#006738"></path>
				<path d="M10 18.6 V26.2 C10 29.2 15 31.8 20 31.8 C25 31.8 30 29.2 30 26.2 V18.6 L20 23 Z" fill="#00592F"></path>
				<path d="M33.5 16 V27.5" stroke="#FFC600" stroke-width="2.4" stroke-linecap="round"></path>
				<circle cx="33.5" cy="29.6" r="2.8" fill="#FFC600"></circle>
			</svg>
			<span class="tumpuk">
				<span class="daftar-teks">Daftar</span>
				<span class="online">Online</span>
			</span>
			{linkAttrs(daftar).target && <span class="sr-only"> (membuka tab baru)</span>}
		</a>
		<a href="#biaya" class="kartu-cepat">
			<span class="tumpuk tengah">
				<span class="rincian">Rincian</span>
				<span class="biaya">Biaya</span>
				<span class="garis" aria-hidden="true"></span>
			</span>
		</a>
		<a href={wa} class="kartu-cepat" {...linkAttrs(wa)}>
			<span class="wa">
				<Ikon nama="whatsapp" ukuran={22} />
			</span>
			<span class="tumpuk">
				<span class="admin">Admin</span>
				<span class="pmb">
					PMB<svg aria-hidden="true" viewBox="0 0 120 18" width="72" height="12">
						<path d="M2 11 C30 3 62 17 118 5" fill="none" stroke="#FFC600" stroke-width="4" stroke-linecap="round"></path>
					</svg>
				</span>
			</span>
			<span class="sr-only"> lewat WhatsApp{linkAttrs(wa).target ? " (membuka tab baru)" : ""}</span>
		</a>
	</div>
</section>

<style>
	.pita-cepat {
		background: var(--abu);
		padding: 46px 0 41px;
	}
	.daftar {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		justify-content: center;
	}
	.kartu-cepat {
		width: 212px;
		height: 106px;
		padding: 0 18px;
		border-radius: var(--radius);
		background: var(--putih);
		box-shadow: 0 4px 14px rgba(3, 51, 29, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		text-decoration: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease;
	}
	.kartu-cepat:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(3, 51, 29, 0.1);
	}
	.toga {
		flex: none;
	}
	.tumpuk {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1;
		text-transform: uppercase;
		font-weight: 900;
		letter-spacing: -0.5px;
	}
	.tumpuk.tengah {
		align-items: center;
	}
	.daftar-teks {
		font-size: 28px;
		color: var(--hijau);
	}
	.online {
		margin-top: 5px;
		font-family: var(--font-ui);
		font-size: 12.5px;
		letter-spacing: 0.6px;
		color: var(--judul);
		background: var(--kuning);
		border-radius: 999px;
		padding: 4px 9px;
	}
	.rincian {
		padding-left: 4px;
		font-weight: 800;
		font-size: 19px;
		letter-spacing: 4px;
		color: var(--hijau);
	}
	.biaya {
		margin-top: 3px;
		font-size: 38px;
		color: var(--hijau-tua);
	}
	.garis {
		margin-top: 6px;
		width: 44px;
		height: 4px;
		border-radius: 2px;
		background: var(--kuning);
	}
	.wa {
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--hijau);
		color: var(--putih);
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.admin,
	.pmb {
		font-size: 30px;
		color: var(--hijau-tua);
	}
	.pmb {
		position: relative;
		margin-top: 2px;
		padding-bottom: 6px;
		color: var(--hijau);
	}
	.pmb svg {
		position: absolute;
		left: -2px;
		bottom: -6px;
	}
</style>
