---
// Pil kategori berita: tautan biasa (bukan tab) — tiap kategori punya URL arsip sendiri.
import type { KategoriBerita } from "@/lib/berita";

interface Props {
	kategori: KategoriBerita[];
	/** Slug kategori yang sedang dibuka; kosong = "Semua". */
	aktif?: string;
}

const { kategori, aktif } = Astro.props;
const daftar = [{ slug: "", label: "Semua", url: "/berita" }, ...kategori.map((k) => ({ slug: k.slug, label: k.label, url: `/berita/kategori/${k.slug}` }))];
---

<nav class="pil-kategori" aria-label="Kategori berita">
	<ul>
		{
			daftar.map((k) => {
				const on = (aktif ?? "") === k.slug;
				return (
					<li>
						<a href={k.url} class="tab" aria-current={on ? "page" : undefined}>
							{k.label}
						</a>
					</li>
				);
			})
		}
	</ul>
	<a href="/rss.xml" class="rss">
		<svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><circle cx="5" cy="19" r="2.2"></circle><path d="M3 10.5v3a7.5 7.5 0 0 1 7.5 7.5h3A10.5 10.5 0 0 0 3 10.5z"></path><path d="M3 4v3a14 14 0 0 1 14 14h3A17 17 0 0 0 3 4z"></path></svg>
		RSS
	</a>
</nav>

<style>
	.pil-kategori {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 16px 24px;
		margin-bottom: 40px;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.tab {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}
	.tab:hover {
		background: var(--kuning);
		color: var(--judul);
		text-decoration: none;
	}
	.tab[aria-current="page"] {
		background: var(--kuning);
		font-weight: 600;
	}
	.rss {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		font-family: var(--font-ui);
		font-weight: 700;
		font-size: 14px;
		color: var(--redup);
	}
	.rss:hover {
		color: var(--hijau);
	}
</style>
