---
// Kartu hijau kanal kontak (padanan kartu Agenda/Pengumuman Unpad): judul serif di atas,
// kartu tautan hijau berisi ikon bulat putih, label kecil, nilai tebal, keterangan, pil kuning.
import { linkAttrs } from "@/lib/cms";
import { segmenPatah } from "@/lib/profil";
import Ikon from "./Ikon.astro";

interface Props {
	judul?: string | null;
	as?: "h2" | "h3";
	href?: string | null;
	ikon: string;
	label: string;
	nilai: string;
	teks?: string | null;
	tombol?: string | null;
}

const { judul, as: Tag = "h2", href, ikon, label, nilai, teks, tombol } = Astro.props;
const El = href ? "a" : "div";
const attrs = href ? { href, ...linkAttrs(href) } : {};
---

<div class="kanal">
	{judul && <Tag class="judul-kanal">{judul}</Tag>}
	<El class:list={["kartu-kanal", { tautan: !!href }]} {...attrs}>
		<span class="atas">
			<span class="ikon">
				<Ikon nama={ikon} ukuran={24} />
			</span>
			<span class="teks-atas">
				<span class="label">{label}</span>
				<span class="nilai">{segmenPatah(nilai).map((b, n) => (n > 0 ? [<wbr />, b] : b))}</span>
			</span>
		</span>
		{teks && <span class="ket">{teks}</span>}
		{
			tombol && (
				<span class="bawah">
					<span class="pil">
						{tombol}
						<Ikon nama="chevron-right" ukuran={11} tebal={3} />
					</span>
				</span>
			)
		}
		{href && linkAttrs(href).target && <span class="sr-only"> (membuka tab baru)</span>}
	</El>
</div>

<style>
	.kanal {
		min-width: 0;
		display: flex;
		flex-direction: column;
	}
	.judul-kanal {
		margin: 0 0 19px;
		font-family: var(--font-judul);
		font-weight: 700;
		font-size: clamp(28px, 3vw, 34px);
		line-height: 1.2;
		letter-spacing: -0.3px;
		color: var(--judul);
	}
	.kartu-kanal {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
		min-height: 262px;
		padding: 26px 26px 28px;
		border-radius: var(--radius-l);
		background: var(--hijau);
		color: var(--putih);
		box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
		text-decoration: none;
	}
	.kartu-kanal.tautan:hover {
		text-decoration: none;
		color: var(--putih);
		background: var(--hijau-gelap);
	}
	.atas {
		display: flex;
		gap: 14px;
		align-items: center;
	}
	.ikon {
		flex: none;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: var(--putih);
		color: var(--hijau);
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.teks-atas {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.label {
		font-family: var(--font-ui);
		font-size: 15px;
		line-height: 1.4;
		color: var(--hijau-muda);
	}
	.nilai {
		font-family: var(--font-judul);
		font-weight: 800;
		font-size: 21px;
		line-height: 1.3;
		color: var(--putih);
		overflow-wrap: break-word;
	}
	.ket {
		display: block;
		margin-top: 20px;
		padding-top: 18px;
		border-top: 1px solid rgba(255, 255, 255, 0.22);
		font-size: 15px;
		line-height: 1.5;
		letter-spacing: 0.3px;
		color: var(--hijau-muda);
		white-space: pre-line;
	}
	.bawah {
		margin-top: auto;
		padding-top: 22px;
	}
	.pil {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 44px;
		padding: 0 20px;
		border-radius: 999px;
		background: var(--kuning);
		color: var(--judul);
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 15px;
	}
	.kartu-kanal.tautan:hover .pil {
		background: var(--kuning-hover);
	}
</style>
