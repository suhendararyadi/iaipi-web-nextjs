---
// Section hijau full-bleed dengan lingkaran dekoratif (padanan section "Pusat Unggulan" Unpad).
// `tua` memakai hijau tua #03331D (padanan section biru tua Unpad).
interface Props {
	tua?: boolean;
	id?: string;
	label?: string;
	labelledby?: string;
	class?: string;
}

const { tua = false, id, label, labelledby, class: className } = Astro.props;
---

<section
	id={id}
	aria-label={label}
	aria-labelledby={labelledby}
	class:list={["section-hijau", tua ? "bg-hijau-tua" : "bg-hijau", className]}
>
	<span class="lingkaran l1" aria-hidden="true"></span>
	<span class="lingkaran l2" aria-hidden="true"></span>
	<span class="lingkaran l3" aria-hidden="true"></span>
	<span class="lingkaran l4" aria-hidden="true"></span>
	<div class="wadah isi">
		<slot />
	</div>
</section>

<style>
	.section-hijau {
		position: relative;
		overflow: hidden;
		padding-block: clamp(72px, 9vw, 131px);
	}
	.isi {
		position: relative;
	}
	.lingkaran {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}
	.l1 {
		left: calc(50% + 208px);
		top: -264px;
		width: 644px;
		height: 644px;
		border: 70px solid rgba(255, 255, 255, 0.07);
	}
	.l2 {
		left: calc(50% + 330px);
		top: -142px;
		width: 400px;
		height: 400px;
		background: rgba(255, 255, 255, 0.07);
	}
	.l3 {
		left: calc(50% - 749px);
		bottom: -261px;
		width: 542px;
		height: 542px;
		border: 48px solid rgba(255, 255, 255, 0.07);
	}
	.l4 {
		left: calc(50% - 655px);
		bottom: -167px;
		width: 354px;
		height: 354px;
		background: rgba(255, 255, 255, 0.07);
	}
	.bg-hijau-tua .lingkaran {
		opacity: 0.7;
	}
	@media (max-width: 700px) {
		.l1 {
			left: auto;
			right: -320px;
		}
		.l2 {
			left: auto;
			right: -220px;
		}
		.l3 {
			left: -360px;
		}
		.l4 {
			left: -260px;
		}
	}
</style>
