---
// Section hijau full-bleed dengan roset geometri Islam (padanan section "Pusat Unggulan" Unpad).
// `tua` memakai hijau tua #03331D (padanan section biru tua Unpad).
import Ornamen from "@/components/ui/Ornamen.astro";

interface Props {
	tua?: boolean;
	id?: string;
	label?: string;
	labelledby?: string;
	class?: string;
}

const { tua = false, id, label, labelledby, class: className } = Astro.props;
---

<section
	id={id}
	aria-label={label}
	aria-labelledby={labelledby}
	class:list={["section-hijau", tua ? "bg-hijau-tua" : "bg-hijau", className]}
>
	<Ornamen jenis="roset" class="roset-kanan" />
	<Ornamen jenis="roset" class="roset-kiri" />
	<div class="wadah isi">
		<slot />
	</div>
</section>

<style>
	.section-hijau {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-block: clamp(72px, 9vw, 131px);
	}
	.isi {
		position: relative;
	}
	.section-hijau :global(.roset-kanan) {
		--ukuran: 620px;
		left: calc(50% + 250px);
		top: -250px;
		color: rgba(255, 255, 255, 0.1);
	}
	.section-hijau :global(.roset-kiri) {
		--ukuran: 520px;
		left: calc(50% - 780px);
		bottom: -240px;
		color: rgba(255, 255, 255, 0.1);
	}
	.bg-hijau-tua :global(.ornamen) {
		color: rgba(255, 255, 255, 0.07);
	}
	@media (max-width: 700px) {
		.section-hijau :global(.roset-kanan) {
			--ukuran: 420px;
			left: auto;
			right: -230px;
			top: -200px;
		}
		.section-hijau :global(.roset-kiri) {
			--ukuran: 380px;
			left: -230px;
			bottom: -200px;
		}
	}
</style>
