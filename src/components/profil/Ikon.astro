/** Nama FontAwesome 4.7 (tanpa awalan "fa-" dan akhiran "-o") → kunci IKON. */
const ALIAS: Record<string, string> = {
	"graduation-cap": "toga",
	"mortar-board": "toga",
	certificate: "award",
	university: "landmark",
	bank: "landmark",
	institution: "landmark",
	"map-marker": "pin",
	desktop: "monitor",
	laptop: "monitor",
	"user-circle": "user",
	lightbulb: "bulb",
	gavel: "scale",
	"balance-scale": "scale",
	bullhorn: "megaphone",
	envelope: "mail",
	"clock-o": "clock",
	th: "grid",
	"th-large": "grid",
	gear: "cog",
	"line-chart": "chart",
	"bar-chart": "chart",
	print: "printer",
	child: "smile",
	comments: "chat",
	comment: "chat",
	"file-text": "form",
	file: "form",
	"check-square": "check",
	"external-link": "external",
	"calendar-check": "calendar",
	"pencil": "pen",
	"paint-brush": "camera",
	"shield-alt": "shield",
};

const kunci = (n: string | null | undefined): string => {
	const bersih = (n ?? "")
		.trim()
		.replace(/^fa\s+/, "")
		.replace(/^fa-/, "")
		.replace(/-o$/, "");
	if (IKON[bersih]) return bersih;
	if (ALIAS[bersih]) return ALIAS[bersih];
	return "star";
};

const isi = IKON[kunci(nama)];
---

<svg
	class={className}
	aria-hidden="true"
	focusable="false"
	viewBox="0 0 24 24"
	width={ukuran}
	height={ukuran}
	fill="none"
	stroke="currentColor"
	stroke-width={tebal}
	stroke-linecap="round"
	stroke-linejoin="round"
	set:html={isi}
/>
