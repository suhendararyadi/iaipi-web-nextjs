// atau kunci di daftar IKON di bawah. Nama yang tidak dikenal memakai ikon bintang.
interface Props {
	nama: string | null | undefined;
	ukuran?: number;
	tebal?: number;
	class?: string;
}

const { nama, ukuran = 24, tebal = 2, class: className } = Astro.props;

