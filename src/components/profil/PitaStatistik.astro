---
// Kartu statistik putih di atas pita hijau (pola Unpad "Akreditasi / Program Studi / ...").
export interface ItemStatistik {
	label: string;
	nilai: string;
	catatan?: string | null;
}

interface Props {
	items: ItemStatistik[];
	label?: string;
	/** Lebar minimum kartu sebelum turun baris (px). */
	min?: number;
}

const { items, label = "Dalam angka", min = 280 } = Astro.props;
const tampil = items.filter((i) => i.nilai && i.label);
---

{
	tampil.length > 0 && (
		<section class="pita-statistik" aria-label={label}>
			<div class="wadah">
				<ul class="grid-auto daftar" style={`--min: ${min}px`}>
					{tampil.map((i) => (
						<li class="kartu-statistik">
							<span class="label">{i.label}</span>
							<span class="nilai">{i.nilai}</span>
							{i.catatan && <span class="catatan">{i.catatan}</span>}
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.daftar {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.kartu-statistik {
		min-height: 318px;
		padding: 24px 40px 40px;
		box-shadow: 0 6px 18px rgba(3, 51, 29, 0.05);
	}
	.kartu-statistik .label {
		letter-spacing: 0.3px;
		max-width: 16em;
	}
	@media (max-width: 600px) {
		.daftar {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 14px;
		}
		.daftar > li:last-child:nth-child(odd) {
			grid-column: 1 / -1;
		}
		.kartu-statistik {
			min-height: 150px;
			padding: 20px 14px;
			gap: 8px;
			border-radius: var(--radius-l);
		}
		.kartu-statistik .label {
			font-size: 16px;
		}
		.kartu-statistik .nilai {
			font-size: 32px;
		}
	}
</style>
