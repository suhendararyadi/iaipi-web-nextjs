---
// Footer hijau (padanan footer unpad.ac.id): logo + media sosial, tiga kolom menu dari
// CMS (footer_sumber, footer_layanan, footer_profil), kontak, pola bintang delapan, dan ornamen lengkung.
import Ornamen from "@/components/ui/Ornamen.astro";
import { linkAttrs, telHref, waHref, withYear, type InfoKampus } from "@/lib/cms";

interface MenuItem {
	id: string;
	label: string;
	url: string;
	target?: string;
}
type Menu = { label?: string; items: MenuItem[] } | null | undefined;

interface Props {
	info: InfoKampus;
	logo: string;
	kolom: { judul: string; menu: Menu }[];
}

const { info, logo, kolom } = Astro.props;
const attrs = (item: MenuItem) => (item.target === "_blank" ? { target: "_blank", rel: "noopener noreferrer" } : linkAttrs(item.url));
const sosial = [
	info.facebook && { label: "Facebook", url: info.facebook, ikon: "fb" },
	info.instagram && { label: "Instagram", url: info.instagram, ikon: "ig" },
	info.youtube && { label: "YouTube", url: info.youtube, ikon: "yt" },
	info.whatsapp && { label: "WhatsApp", url: waHref(info), ikon: "wa" },
].filter(Boolean) as { label: string; url: string; ikon: string }[];
---

<footer class="footer">
	<Ornamen jenis="pola" pudar="kiri" />
	<div class="wadah">
		<div class="footer-atas">
			<a href="/" class="footer-merek">
				<span class="footer-logo"><img src={logo} alt="" width="38" height="52" /></span>
				<span>Institut Agama Islam<br />PERSIS Garut</span>
			</a>
			<div class="sosial">
				{
					sosial.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
							{s.ikon === "fb" && (
								<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v9h4v-9h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8z" /></svg>
							)}
							{s.ikon === "ig" && (
								<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="1" fill="currentColor" /></svg>
							)}
							{s.ikon === "yt" && (
								<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M22 8.2c-.2-1.6-1-2.7-2.6-2.9C16.9 5 12 5 12 5s-4.9 0-7.4.3C3 5.5 2.2 6.6 2 8.2 1.8 9.6 1.8 12 1.8 12s0 2.4.2 3.8c.2 1.6 1 2.7 2.6 2.9 2.5.3 7.4.3 7.4.3s4.9 0 7.4-.3c1.6-.2 2.4-1.3 2.6-2.9.2-1.4.2-3.8.2-3.8s0-2.4-.2-3.8zM10 15V9l5.2 3L10 15z" /></svg>
							)}
							{s.ikon === "wa" && (
								<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7L4 20z" /><path d="M9 9.5c.3 2 2 4 5 5l1.2-1.3-2-1-1 .8c-1-.5-1.8-1.3-2.3-2.3l.8-1-1-2L9 9.5z" fill="currentColor" stroke="none" /></svg>
							)}
						</a>
					))
				}
			</div>
		</div>

		<div class="footer-kolom">
			{
				kolom.map((k) => (
					<div>
						<h2>{k.judul}</h2>
						<ul>
							{(k.menu?.items ?? []).map((item) => (
								<li>
									<a href={item.url} {...attrs(item)}>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="footer-kontak">
			{info.alamat && <span>{info.alamat}</span>}
			{info.telepon && <a href={telHref(info.telepon)}>{info.telepon}</a>}
			{info.email && <a href={`mailto:${info.email}`}>{info.email}</a>}
		</div>
	</div>

	<svg class="footer-ornamen" aria-hidden="true" viewBox="0 0 1440 170" preserveAspectRatio="none">
		<path d="M0 120 C240 80 480 150 720 112 C960 74 1200 140 1440 100 L1440 170 L0 170 Z" fill="#00592F"></path>
		<g fill="#004A27">
			<path d="M880 170 V92 a38 38 0 0 1 76 0 V170 Z"></path>
			<path d="M968 170 V70 a46 46 0 0 1 92 0 V170 Z"></path>
			<path d="M1072 170 V92 a38 38 0 0 1 76 0 V170 Z"></path>
			<path d="M1160 170 V108 a30 30 0 0 1 60 0 V170 Z"></path>
		</g>
		<path d="M968 170 V70 a46 46 0 0 1 92 0 V170" fill="none" stroke="#FFC600" stroke-width="3" opacity="0.55"></path>
	</svg>
	<p class="hak-cipta">
		{withYear(info.teks_hak_cipta) || `© ${new Date().getFullYear()} ${info.nama}`}
		{info.teks_pengembang && <span> · {info.teks_pengembang}</span>}
	</p>
</footer>

<style>
	.footer {
		background: var(--hijau);
		color: var(--putih);
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding-top: 60px;
	}
	.footer a {
		color: var(--putih);
	}
	.footer-atas {
		display: flex;
		flex-wrap: wrap;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
	}
	.footer-merek {
		display: flex;
		align-items: center;
		gap: 14px;
		font-family: var(--font-judul);
		font-weight: 700;
		font-size: 22px;
		line-height: 1.15;
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}
	.footer-merek:hover {
		text-decoration: none;
	}
	.footer-logo {
		background: var(--putih);
		border-radius: 12px;
		padding: 6px 8px;
		display: inline-flex;
	}
	.footer-logo img {
		width: 38px;
		height: 52px;
		object-fit: contain;
	}
	.sosial {
		display: flex;
		gap: 14px;
	}
	.sosial a {
		width: 46px;
		height: 46px;
		border-radius: var(--radius-s);
		background: rgba(255, 255, 255, 0.16);
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.sosial a:hover {
		background: rgba(255, 255, 255, 0.28);
	}
	.footer-kolom {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 36px;
		margin-top: 64px;
		text-align: center;
	}
	.footer-kolom h2 {
		color: var(--putih);
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 18px;
		margin-bottom: 14px;
	}
	.footer-kolom ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 16px;
		letter-spacing: 0.3px;
	}
	.footer-kontak {
		margin-top: 56px;
		display: flex;
		flex-wrap: wrap;
		gap: 8px 40px;
		justify-content: center;
		text-align: center;
		color: var(--hijau-muda);
		letter-spacing: 0.3px;
	}
	.footer-ornamen {
		display: block;
		width: 100%;
		height: 170px;
		margin-top: 32px;
	}
	.hak-cipta {
		position: absolute;
		left: 16px;
		right: 16px;
		bottom: 18px;
		text-align: center;
		font-size: 15px;
		letter-spacing: 0.3px;
	}
</style>
