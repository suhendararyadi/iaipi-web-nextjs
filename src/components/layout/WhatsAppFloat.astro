---
import { waHref, type InfoKampus } from "@/lib/cms";

interface Props {
	info: InfoKampus;
}

const { info } = Astro.props;
---

{
	info.whatsapp && (
		<a href={waHref(info)} class="wa-float" target="_blank" rel="noopener noreferrer" data-wa-float hidden>
			<svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7L4 20z" /><path d="M9 9.5c.3 2 2 4 5 5l1.2-1.3-2-1-1 .8c-1-.5-1.8-1.3-2.3-2.3l.8-1-1-2L9 9.5z" fill="currentColor" stroke="none" /></svg>
			<span>Chat Admin</span>
		</a>
	)
}

<style>
	.wa-float {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 90;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 18px;
		border-radius: 999px;
		background: var(--hijau);
		color: var(--putih);
		font-family: var(--font-ui);
		font-weight: 700;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	}
	@media (max-width: 600px) {
		.wa-float {
			right: 14px;
			bottom: 14px;
			width: 52px;
			height: 52px;
			padding: 0;
			justify-content: center;
		}
		.wa-float span {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
		}
	}
	.wa-float:hover {
		background: var(--hijau-tua);
		color: var(--putih);
		text-decoration: none;
	}
</style>
