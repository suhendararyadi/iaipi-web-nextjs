---
// Pita tautan cepat di bawah hero: kartu putih berisi "wordmark" tipografis dari judul.
// Bentuk wordmark dipilih otomatis dari judul (beranda.tautan_cepat):
// - judul berakhiran angka/tahun ("PMB 2026/2027") → kata hijau + pil kuning
// - satu kata ("Berita")                           → kata besar bergaris coret kuning
// - dua kata atau lebih ("Jurnal Ilmiah")          → dua baris (kecil berjarak + besar)
import { linkAttrs } from "@/lib/cms";
import type { TautanCepat } from "@/lib/beranda";

interface Props {
	items: TautanCepat[];
}

const items = Astro.props.items.filter((t) => t.judul && t.url);

type Bentuk = { jenis: "pil"; kata: string; pil: string } | { jenis: "tunggal"; kata: string } | { jenis: "dua"; atas: string; bawah: string };

function bentuk(judul: string): Bentuk {
	const kata = judul.trim().split(/\s+/);
	const akhir = kata[kata.length - 1];
	if (kata.length > 1 && /\d/.test(akhir)) return { jenis: "pil", kata: kata.slice(0, -1).join(" "), pil: akhir };
	if (kata.length === 1) return { jenis: "tunggal", kata: kata[0] };
	return { jenis: "dua", atas: kata[0], bawah: kata.slice(1).join(" ") };
}
---

{
	items.length > 0 && (
		<section class="tautan-cepat" aria-label="Tautan cepat">
			<ul class="wadah daftar" role="list">
				{items.map((t) => {
					const b = bentuk(t.judul!);
					return (
						<li>
							<a href={t.url} class="kartu-tautan" title={t.keterangan || undefined} {...linkAttrs(t.url)}>
								{b.jenis === "pil" && (
									<>
										<svg aria-hidden="true" viewBox="0 0 40 40" width="42" height="42" class="ikon">
											<path d="M20 7 L37 14.5 L20 22 L3 14.5 Z" fill="#006738" />
											<path d="M10 18.6 V26.2 C10 29.2 15 31.8 20 31.8 C25 31.8 30 29.2 30 26.2 V18.6 L20 23 Z" fill="#00592F" />
											<path d="M33.5 16 V27.5" stroke="#FFC600" stroke-width="2.4" stroke-linecap="round" />
											<circle cx="33.5" cy="29.6" r="2.8" fill="#FFC600" />
										</svg>
										<span class="pil-tumpuk">
											<span class="kata-hijau">{b.kata}</span>
											<span class="pil">{b.pil}</span>
										</span>
									</>
								)}
								{b.jenis === "tunggal" && (
									<span class="kata-tunggal">
										{b.kata}
										<svg aria-hidden="true" viewBox="0 0 120 18" width="104" height="16">
											<path d="M2 11 C30 3 62 17 118 5" fill="none" stroke="#FFC600" stroke-width="4" stroke-linecap="round" />
											<path d="M16 16 C44 9 74 18 112 11" fill="none" stroke="#006738" stroke-width="2" stroke-linecap="round" />
										</svg>
									</span>
								)}
								{b.jenis === "dua" && (
									<span class="dua-baris">
										<span class="atas">{b.atas}</span>
										<span class="bawah">{b.bawah}</span>
										<span class="garis" aria-hidden="true" />
									</span>
								)}
								{t.keterangan && <span class="sr-only">— {t.keterangan}</span>}
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.tautan-cepat {
		background: var(--abu);
		padding: 46px 0 41px;
	}
	.daftar {
		position: relative;
		list-style: none;
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		justify-content: center;
	}
	.kartu-tautan {
		position: relative;
		width: 212px;
		height: 106px;
		padding: 0 18px;
		border-radius: var(--radius);
		background: var(--putih);
		box-shadow: 0 4px 14px rgba(3, 51, 29, 0.06);
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.kartu-tautan:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(3, 51, 29, 0.1);
	}
	.ikon {
		flex: none;
	}
	.pil-tumpuk {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 5px;
	}
	.kata-hijau {
		font-weight: 900;
		font-size: 32px;
		line-height: 1;
		letter-spacing: -0.5px;
		color: var(--hijau);
	}
	.pil {
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 12.5px;
		line-height: 1;
		letter-spacing: 0.6px;
		color: var(--judul);
		background: var(--kuning);
		border-radius: 999px;
		padding: 4px 9px;
	}
	.kata-tunggal {
		position: relative;
		display: inline-block;
		padding-bottom: 6px;
		font-weight: 900;
		font-size: 44px;
		line-height: 1;
		letter-spacing: -1px;
		color: var(--hijau-tua);
	}
	.kata-tunggal svg {
		position: absolute;
		right: -16px;
		bottom: -8px;
	}
	.dua-baris {
		display: flex;
		flex-direction: column;
		align-items: center;
		line-height: 1;
	}
	.atas {
		padding-left: 4px;
		font-weight: 800;
		font-size: 19px;
		letter-spacing: 4px;
		color: var(--hijau);
	}
	.bawah {
		margin-top: 3px;
		font-weight: 900;
		font-size: 38px;
		letter-spacing: -0.5px;
		color: var(--hijau-tua);
	}
	.garis {
		margin-top: 6px;
		width: 44px;
		height: 4px;
		border-radius: 2px;
		background: var(--kuning);
	}
	/* Layar sempit: satu baris yang bisa digeser, kartu berikutnya mengintip di tepi. */
	@media (max-width: 720px) {
		.tautan-cepat {
			padding: 28px 0 24px;
		}
		.daftar {
			flex-wrap: nowrap;
			justify-content: flex-start;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: 24px;
			scrollbar-width: none;
			padding-block: 4px 12px;
		}
		.daftar::-webkit-scrollbar {
			display: none;
		}
		.daftar li {
			flex: 0 0 auto;
			scroll-snap-align: start;
		}
		.kartu-tautan {
			width: 196px;
			height: 96px;
		}
	}
</style>
