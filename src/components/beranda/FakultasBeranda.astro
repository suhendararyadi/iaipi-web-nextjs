---
// "Fakultas di IAI PERSIS Garut": kartu per fakultas (termasuk Program Pascasarjana) dengan
// singkatan prodi. Sumber: koleksi `fakultas` & `prodi`, teks dari beranda.fakultas_*.
import KepalaSection from "@/components/ui/KepalaSection.astro";
import { mediaAlt, mediaSrc } from "@/lib/cms";
import { kalimatPertama, type FakultasEntry, type ProdiEntry } from "@/lib/akademik";

interface Props {
	judul?: string;
	teks?: string;
	fakultas: FakultasEntry[];
	prodi: ProdiEntry[];
}

const { judul, teks, fakultas, prodi } = Astro.props;

const kartu = fakultas.map((f) => {
	const d = f.data;
	const pasca = d.jenjang === "S2";
	const gambar = d.gambar ?? d.gambar_banner;
	return {
		id: f.id,
		nama: d.nama,
		// "Fakultas Ushuluddin" → "Ushuluddin": judul section sudah menyebut "Fakultas".
		judul: d.nama.replace(/^Fakultas\s+/i, ""),
		deskripsi: d.deskripsi_singkat || kalimatPertama(d.deskripsi),
		src: mediaSrc(gambar),
		alt: mediaAlt(gambar, d.nama),
		url: pasca ? "/magister" : `/fakultas/${f.id}`,
		prodi: prodi.filter((p) => p.data.fakultas === f.id && p.data.singkatan),
	};
});
---

{
	kartu.length > 0 && (
		<section id="fakultas" class="fakultas" aria-labelledby="fakultas-judul">
			<div class="wadah">
				<KepalaSection judul={judul || "Fakultas"} teks={teks} ukuran="sedang" id="fakultas-judul" />
				<ul class="grid" role="list">
					{kartu.map((k) => (
						<li class="kartu">
							{k.src ? <img class="kartu-gambar" src={k.src} alt={k.alt} loading="lazy" decoding="async" /> : <div class="kartu-gambar" aria-hidden="true" />}
							<div class="kartu-isi isi">
								<h3>{k.judul}</h3>
								<p>
									{k.deskripsi}
									{k.prodi.length > 0 && (
										<>
											{" "}
											Prodi:{" "}
											{k.prodi.map((p, i) => (
												<>
													<abbr title={p.data.nama}>{p.data.singkatan}</abbr>
													{i < k.prodi.length - 1 ? ", " : "."}
												</>
											))}
										</>
									)}
								</p>
								<a href={k.url} class="btn btn-kuning btn-kecil tombol">
									Selengkapnya<span class="sr-only"> tentang {k.nama}</span>
									<svg aria-hidden="true" viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
										<path d="M9 6l6 6-6 6" />
									</svg>
								</a>
							</div>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	.fakultas {
		padding: 64px 0 60px;
	}
	.fakultas :global(.kepala-section) {
		margin-bottom: 46px;
	}
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
		gap: 30px;
	}
	.kartu {
		min-width: 0;
		min-height: clamp(440px, 42.3vw, 511px);
		border-radius: var(--radius-l);
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
	}
	.isi {
		padding: 20px 20px 26px;
	}
	.isi h3 {
		line-height: 1.3;
		color: var(--judul);
	}
	.isi p {
		line-height: 24px;
		letter-spacing: 0.3px;
	}
	abbr {
		text-decoration: none;
		cursor: help;
	}
	.tombol {
		position: relative;
		gap: 8px;
		margin-top: auto;
		padding: 0 18px 0 16px;
	}
	/* target sentuh 44px tanpa mengubah ukuran pil 34px */
	.tombol::before {
		content: "";
		position: absolute;
		inset: -5px 0;
	}
	@media (max-width: 600px) {
		.kartu {
			min-height: 0;
		}
		.tombol {
			margin-top: 12px;
		}
	}
</style>
