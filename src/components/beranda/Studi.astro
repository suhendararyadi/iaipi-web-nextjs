---
// "Studi di IAI PERSIS Garut": kepala section + kartu foto (kartu pertama tinggi di kiri,
// sisanya bertumpuk di kanan). Sumber: beranda.studi_*.
import KepalaSection from "@/components/ui/KepalaSection.astro";
import { linkAttrs, mediaAlt, mediaSrc, tanpaSorot } from "@/lib/cms";
import type { KartuStudi } from "@/lib/beranda";

interface Props {
	judul?: string;
	teks?: string;
	kartu: KartuStudi[];
}

const { judul, teks } = Astro.props;
const kartu = Astro.props.kartu.filter((k) => k.judul);
const [utama, ...lain] = kartu;
---

{
	(judul || kartu.length > 0) && (
		<section id="studi" class="studi" aria-labelledby="studi-judul">
			<div class="wadah">
				<KepalaSection judul={judul} teks={teks} id="studi-judul" />
				{utama && (
					<div class:list={["grid", { tunggal: lain.length === 0 }]}>
						{[utama, ...lain].map((k, i) => (
							<div class:list={["kartu-foto", "sk", { tinggi: i === 0 }]}>
								{mediaSrc(k.gambar) && <img src={mediaSrc(k.gambar)} alt={mediaAlt(k.gambar, k.judul)} loading="lazy" decoding="async" />}
								<div class="kartu-foto-isi isi">
									<h3 class="kartu-foto-judul">{k.judul}</h3>
									{k.url && (
										<a href={k.url} class="btn btn-kuning tombol" {...linkAttrs(k.url)}>
											{k.teks_tombol || "Lihat semua"}
											<span class="sr-only">: {tanpaSorot(k.judul)}</span>
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				)}
			</div>
		</section>
	)
}

<style>
	.studi {
		padding: 80px 0 60px;
	}
	.studi :global(.kepala-section) {
		margin-bottom: 52px;
	}
	.studi :global(.pemisah) {
		margin-bottom: 14px;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-auto-rows: 315px;
		gap: 40px 30px;
	}
	.grid.tunggal {
		grid-template-columns: 1fr;
		grid-auto-rows: 420px;
	}
	.sk.tinggi {
		grid-row: span 2;
	}
	.grid.tunggal .sk.tinggi {
		grid-row: auto;
	}
	.sk {
		min-height: 0;
	}
	.sk::after {
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 30%, rgba(0, 0, 0, 0.6) 52%, rgba(0, 0, 0, 0.85) 70%, #000 87%);
	}
	.sk.tinggi::after {
		background: linear-gradient(180deg, rgba(0, 0, 0, 0) 50%, rgba(0, 0, 0, 0.6) 66%, rgba(0, 0, 0, 0.85) 80%, #000 92%);
	}
	.isi {
		padding: 0 20px 29px;
		gap: 24px;
	}
	.tinggi .isi {
		padding-bottom: 30px;
	}
	.kartu-foto-judul {
		font-size: clamp(26px, 2.5vw, 36px);
		line-height: 1.15;
	}
	.tombol {
		min-height: 50px;
		min-width: 134px;
		padding: 0 24px;
	}
	@media (max-width: 800px) {
		.grid {
			grid-template-columns: 1fr;
			grid-auto-rows: auto;
			gap: 24px;
		}
		.sk {
			min-height: 280px;
		}
		.sk.tinggi {
			grid-row: auto;
			min-height: 360px;
		}
	}
	@media (max-width: 600px) {
		.studi {
			padding: 56px 0 40px;
		}
		.studi :global(.kepala-section) {
			margin-bottom: 32px;
		}
	}
</style>
