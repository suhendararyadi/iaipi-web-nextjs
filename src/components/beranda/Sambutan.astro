---
// "Belajar di Garut Bersama IAI PERSIS": sambutan pimpinan ber-`kutipan` (rektor lebih dulu)
// di atas section hijau tua berlatar foto samar. Lebih dari satu → carousel (data-carousel).
import JudulSorot from "@/components/ui/JudulSorot.astro";
import { mediaAlt, mediaSrc, paragraphs } from "@/lib/cms";
import type { MediaField } from "@/lib/cms";
import type { PimpinanEntry } from "@/lib/pimpinan";

interface Props {
	judul?: string;
	latar?: MediaField;
	pimpinan: PimpinanEntry[];
	kampus: string;
}

const { judul, latar, kampus } = Astro.props;
const URUTAN_KELOMPOK = { rektor: 0, wakil_rektor: 1, dekan: 2, kaprodi: 3 } as const;
const daftar = Astro.props.pimpinan
	.filter((p) => p.data.kutipan?.trim())
	.sort((a, b) => (URUTAN_KELOMPOK[a.data.kelompok] ?? 9) - (URUTAN_KELOMPOK[b.data.kelompok] ?? 9));
const banyak = daftar.length > 1;
const latarSrc = mediaSrc(latar);

/** Kalimat pertama profil, tanpa memotong singkatan gelar seperti "Dr." atau "H.". */
function kalimatProfil(text: string | undefined): string {
	const isi = (text ?? "").replace(/\s+/g, " ").trim();
	const m = isi.match(/^.*?[a-zÀ-ɏ)]{3,}[.!?](?=\s+[A-Z]|$)/);
	return (m ? m[0] : "").trim();
}

/** "Rektor" → "Rektor IAI PERSIS Garut" (jabatan yang sudah menyebut lembaga dibiarkan). */
function jabatanLengkap(jabatan: string): string {
	return /institut|iai|fakultas|prodi|program/i.test(jabatan) ? jabatan : `${jabatan} ${kampus}`;
}
---

{
	daftar.length > 0 && (
		<section id="sambutan" class="sambutan" aria-labelledby="sambutan-judul">
			{judul && (
				<div class="wadah kepala">
					<JudulSorot text={judul} id="sambutan-judul" />
					<hr class="pemisah" />
				</div>
			)}
			<div class="panggung">
				{latarSrc && <img class="latar" src={latarSrc} alt="" loading="lazy" decoding="async" />}
				<div class="wadah">
					<div class="carousel" data-carousel aria-roledescription={banyak ? "carousel" : undefined} aria-label={judul ? undefined : "Sambutan pimpinan"}>
						{!judul && <h2 id="sambutan-judul" class="sr-only">Sambutan pimpinan</h2>}
						<div class="carousel-jalur jalur">
							{daftar.map((p, i) => {
								const d = p.data;
								const foto = d.foto_sambutan ?? d.foto;
								const fotoSrc = mediaSrc(foto);
								const profil = kalimatProfil(d.tentang);
								return (
									<article class="slide" aria-roledescription={banyak ? "slide" : undefined} aria-label={banyak ? `${i + 1} dari ${daftar.length}: ${d.nama}` : undefined}>
										<div class="sosok">
											{fotoSrc && <img src={fotoSrc} alt={mediaAlt(foto, d.nama)} loading="lazy" decoding="async" />}
											<p class="nama">
												<a href={`/pimpinan/${p.id}`}>{d.nama}</a>
											</p>
											<p class="jabatan">{jabatanLengkap(d.jabatan)}</p>
										</div>
										<div class="ucapan">
											<h3>“Selamat Datang”</h3>
											<blockquote>
												{paragraphs(d.kutipan).map((teks) => (
													<p>{teks}</p>
												))}
											</blockquote>
											{profil && <p>{profil}</p>}
										</div>
									</article>
								);
							})}
						</div>
						{banyak && (
							<>
								<button type="button" class="panah kiri" aria-label="Pimpinan sebelumnya" data-prev>
									<svg aria-hidden="true" viewBox="0 0 24 40" width="22" height="36" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M17 5L6 20l11 15" />
									</svg>
								</button>
								<button type="button" class="panah kanan" aria-label="Pimpinan berikutnya" data-next>
									<svg aria-hidden="true" viewBox="0 0 24 40" width="22" height="36" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
										<path d="M7 5l11 15L7 35" />
									</svg>
								</button>
							</>
						)}
					</div>
					<div class="aksi">
						<a href="/pimpinan" class="btn btn-kuning">Profil Pimpinan</a>
					</div>
				</div>
			</div>
		</section>
	)
}

<style>
	.kepala {
		padding-block: 58px 76px;
	}
	.kepala .pemisah {
		margin-bottom: 0;
	}
	.kepala :global(h2) {
		text-wrap: balance;
	}
	.panggung {
		position: relative;
		overflow: hidden;
		background: var(--hijau-tua);
		padding: 120px 0;
		isolation: isolate;
	}
	.latar {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.18;
		z-index: -1;
	}
	.jalur {
		--kolom: 100%;
		gap: 30px;
		padding: 0;
	}
	.slide {
		display: flex;
		flex-wrap: wrap;
		gap: 24px 31px;
		padding: 50px clamp(24px, 6vw, 86px) 64px clamp(24px, 4.2vw, 60px);
		border-radius: var(--radius-xl);
		background: rgba(0, 0, 0, 0.28);
		color: var(--putih);
	}
	.sosok {
		flex: 0 1 316px;
		min-width: 0;
		margin-inline: auto;
		text-align: center;
	}
	.sosok img {
		width: 100%;
		height: 316px;
		object-fit: cover;
		object-position: center top;
		border-radius: var(--radius);
		background: #0e2a1b;
	}
	.nama {
		margin-top: 20px;
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 17px;
		line-height: 1.3;
	}
	.nama a {
		color: var(--kuning);
	}
	.jabatan {
		margin-top: 6px;
		font-family: var(--font-ui);
		font-size: 15px;
		line-height: 1.4;
		letter-spacing: 0.2px;
		color: var(--hijau-muda);
	}
	.ucapan {
		flex: 1 1 320px;
		min-width: 0;
		font-size: 18px;
		line-height: 1.35;
		letter-spacing: 0.4px;
	}
	.ucapan h3 {
		text-align: center;
		font-weight: 800;
		font-style: italic;
		font-size: 32px;
		line-height: 1.2;
		color: var(--putih);
	}
	blockquote {
		margin: 18px 0 0;
	}
	blockquote p + p,
	blockquote + p {
		margin-top: 12px;
	}
	.panah {
		position: absolute;
		z-index: 2;
		top: 55%;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		padding: 0;
		border: 0;
		background: transparent;
		color: rgba(255, 255, 255, 0.85);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.panah:hover {
		color: var(--kuning);
	}
	.panah.kiri {
		left: max(-47px, min(-24px, (1160px - 100vw) / 2));
	}
	.panah.kanan {
		right: max(-47px, min(-24px, (1160px - 100vw) / 2));
	}
	.aksi {
		margin-top: 55px;
		display: flex;
		justify-content: center;
	}
	.aksi .btn {
		min-height: 50px;
	}
	@media (max-width: 600px) {
		.kepala {
			padding-block: 40px 32px;
		}
		.panggung {
			padding: 56px 0;
		}
		.slide {
			padding: 28px 20px 32px;
		}
		.sosok img {
			height: 280px;
		}
		.ucapan {
			font-size: 16px;
		}
		.ucapan h3 {
			font-size: 26px;
		}
		.panah {
			top: 160px;
		}
		.panah.kiri {
			left: -20px;
		}
		.panah.kanan {
			right: -20px;
		}
		.aksi {
			margin-top: 36px;
		}
	}
</style>
