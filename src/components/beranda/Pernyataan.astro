---
// Pernyataan besar terpusat dengan watermark logo dan lencana "stiker" miring.
import JudulSorot from "@/components/ui/JudulSorot.astro";

interface Props {
	judul?: string;
	teks?: string;
	lencana?: string;
	logo: string;
}

const { judul, teks, lencana, logo } = Astro.props;

// Lencana dipecah menjadi tiga tingkat: "Kampus Saintek" / "Dakwah" / "Turats Islam".
const kata = (lencana ?? "").trim().split(/\s+/).filter(Boolean);
const tingkat =
	kata.length >= 4
		? [kata.slice(0, 2).join(" "), kata[2], kata.slice(3).join(" ")]
		: kata.length === 3
			? [kata[0], kata[1], kata[2]]
			: kata.length > 0
				? ["", kata.join(" "), ""]
				: [];
---

{
	(judul || teks) && (
		<section class="pernyataan" aria-labelledby="pernyataan-judul">
			<div class="wadah isi">
				<img class="watermark" src={logo} alt="" aria-hidden="true" />
				<JudulSorot text={judul} id="pernyataan-judul" class="judul-besar judul" />
				{teks && <p class="teks">{teks}</p>}
				{tingkat.length > 0 && (
					<p class="lencana-wrap">
						<span class="stiker">
							{tingkat[0] && <span class="s1">{tingkat[0]}</span>}
							<span class="s2">{tingkat[1]}</span>
							{tingkat[2] && <span class="s3">{tingkat[2]}</span>}
						</span>
					</p>
				)}
			</div>
		</section>
	)
}

<style>
	.pernyataan {
		position: relative;
		overflow: hidden;
		background: var(--putih);
		padding: 90px 0 59px;
	}
	.isi {
		position: relative;
		text-align: center;
	}
	.watermark {
		position: absolute;
		left: 50%;
		top: -8px;
		width: 210px;
		height: 300px;
		transform: translateX(-50%);
		object-fit: contain;
		opacity: 0.06;
		pointer-events: none;
	}
	.isi :global(.judul) {
		position: relative;
		max-width: 1000px;
		margin: 0 auto;
		font-size: clamp(34px, 5vw, 72px);
		line-height: 1.27;
	}
	.teks {
		position: relative;
		max-width: 960px;
		margin: 14px auto 0;
		font-size: 18px;
		line-height: 1.72;
		letter-spacing: 0.3px;
		color: var(--teks);
	}
	.lencana-wrap {
		position: relative;
		margin-top: 16px;
		display: flex;
		justify-content: center;
	}
	.stiker {
		display: inline-flex;
		flex-direction: column;
		align-items: center;
		line-height: 1;
		transform: rotate(-4deg);
		text-transform: uppercase;
		font-style: italic;
		font-weight: 900;
	}
	.s1 {
		display: inline-block;
		padding: 3px 7px;
		border-radius: 4px;
		background: var(--kuning);
		transform: skewX(-8deg);
		font-family: var(--font-ui);
		font-size: 10px;
		letter-spacing: 0.8px;
		color: var(--judul);
	}
	.s2 {
		display: inline-block;
		margin-top: 3px;
		font-size: 22px;
		letter-spacing: -0.2px;
		color: var(--hijau);
	}
	.s3 {
		display: inline-block;
		margin-top: 1px;
		font-family: var(--font-ui);
		font-size: 11px;
		letter-spacing: 1px;
		color: var(--hijau-tua);
	}
	@media (max-width: 600px) {
		.pernyataan {
			padding: 56px 0 40px;
		}
		.teks {
			font-size: 16px;
			line-height: 1.6;
		}
	}
</style>
