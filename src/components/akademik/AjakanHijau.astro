---
// Section ajakan berlatar hijau tua + foto kampus samar (penutup halaman akademik).
interface Tombol {
	teks: string;
	href: string;
	gaya?: "kuning" | "garis-putih";
}

interface Props {
	judul: string;
	teks?: string | null;
	tombol: Tombol[];
	gambar?: string;
	editJudul?: Record<string, string>;
	editTeks?: Record<string, string>;
	id?: string;
}

const { judul, teks, tombol, gambar = "/images/slider/slider-iaipi-1.jpg", editJudul, editTeks, id = "ajakan-judul" } = Astro.props;
---

<section class="ajakan-hijau" aria-labelledby={id}>
	<img class="latar" src={gambar} alt="" loading="lazy" />
	<div class="wadah">
		<h2 id={id} {...editJudul}>{judul}</h2>
		{teks && <p {...editTeks}>{teks}</p>}
		<div class="aksi">
			{
				tombol.map((t) => (
					<a class:list={["btn", t.gaya === "garis-putih" ? "btn-garis-putih" : "btn-kuning"]} href={t.href}>
						{t.teks}
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.ajakan-hijau {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		background: var(--hijau-tua);
		color: var(--putih);
		padding-block: 110px 120px;
		text-align: center;
	}
	.latar {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.18;
		z-index: -1;
	}
	h2 {
		color: var(--putih);
		font-family: var(--font-isi);
		font-weight: 900;
		font-size: clamp(32px, 4.4vw, 60px);
		line-height: 1.15;
		letter-spacing: -0.5px;
		max-width: 960px;
		margin-inline: auto;
	}
	p {
		margin: 22px auto 0;
		max-width: 820px;
		font-size: 18px;
		line-height: 1.5;
		letter-spacing: 0.3px;
		color: var(--hijau-muda);
	}
	.aksi {
		margin-top: 36px;
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		justify-content: center;
	}
	@media (max-width: 600px) {
		.ajakan-hijau {
			padding-block: 72px 80px;
		}
	}
</style>
