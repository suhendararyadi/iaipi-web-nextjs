---
// Detail program studi (S1 & S2) mengikuti desain Prodi.dc.html:
// banner foto → kartu statistik di atas pita hijau → "Tentang <singkatan>" + tab
// (Profil / Kurikulum / Fasilitas / Prospek Karir) → Ketua Program Studi → ajakan daftar.
// Bagian/tab yang datanya kosong di CMS tidak ditampilkan.
import type { HTMLAttributes } from "astro/types";
import PageBanner from "@/components/layout/PageBanner.astro";
import JudulSorot from "@/components/ui/JudulSorot.astro";
import KepalaSection from "@/components/ui/KepalaSection.astro";
import Ornamen from "@/components/ui/Ornamen.astro";
import Ikon from "@/components/akademik/Ikon.astro";
import PitaStatistik, { type ItemStatistik } from "@/components/akademik/PitaStatistik.astro";
import { lines, mediaAlt, mediaSrc, paragraphs } from "@/lib/cms";
import {
	blokTeks,
	daftar,
	daftarCatatan,
	daftarSemester,
	durasiSemester,
	durasiTahun,
	kepanjanganGelar,
	mataKuliah,
	tanpaEntitas,
	tebal,
	totalSks,
	totalSksKurikulum,
	type FakultasEntry,
	type JudulDeskripsi,
	type KaprodiProfil,
	type KartuDaftar,
	type ProdiEntry,
	type ProfilLulusan,
} from "@/lib/akademik";

interface Props {
	prodi: ProdiEntry;
	fakultas?: FakultasEntry | null;
	kaprodi?: KaprodiProfil | null;
}

const { prodi, fakultas, kaprodi } = Astro.props;
const p = prodi.data;
const edit = prodi.edit ?? {};
const s2 = p.jenjang === "S2";
const singkatan = (p.singkatan || p.nama).replace(/\*/g, "");

// ---------- Banner ----------
const namaFakultas = fakultas?.data.nama || (s2 ? "Program Pascasarjana" : "");
const breadcrumbs = s2
	? [{ text: "Beranda", url: "/" }, { text: "Program Magister", url: "/magister" }, { text: p.nama }]
	: [
			{ text: "Beranda", url: "/" },
			{ text: "Fakultas", url: "/fakultas" },
			...(fakultas ? [{ text: fakultas.data.nama, url: `/fakultas/${fakultas.id}` }] : []),
			{ text: p.nama },
		];
const bannerSrc = mediaSrc(p.gambar_banner) || "/images/slider/slider-iaipi-2.jpg";
const bannerAlt = mediaAlt(p.gambar_banner) || (mediaSrc(p.gambar_banner) ? p.nama : "");
const lencana = [p.jenjang, namaFakultas].filter(Boolean).join(" · ");

// ---------- Data isi ----------
const deskripsi = paragraphs(p.deskripsi);
const misi = lines(p.misi);
const tujuan = blokTeks(p.tujuan);
// Judul/deskripsi repeater dibersihkan dari entitas HTML sisa migrasi (mis. "Da&apos;i").
const rapikan = <T extends { judul: string; deskripsi?: string }>(xs: T[]): T[] =>
	xs.map((x) => ({ ...x, judul: tanpaEntitas(x.judul), deskripsi: x.deskripsi ? tanpaEntitas(x.deskripsi) : x.deskripsi }));
const profilLulusan = rapikan(daftar<ProfilLulusan>(p.profil_lulusan));
const kompetensi = rapikan(daftar<JudulDeskripsi>(p.kompetensi));
const keunggulan = rapikan(daftar<JudulDeskripsi>(p.keunggulan));
const kurikulum = daftarSemester(p.kurikulum);
const fasilitas = daftar<KartuDaftar>(p.fasilitas).map((f) => ({ ...f, judul: tanpaEntitas(f.judul) }));
const karir = daftar<KartuDaftar>(p.karir).map((k) => ({ ...k, judul: tanpaEntitas(k.judul) }));
const catatan = daftarCatatan(p.catatan);
const bersih = (s: string | undefined) => (s ?? "").replace(/[“”"]/g, "").replace(/\s+/g, " ").trim();
// Catatan yang isinya sama dengan Visi (data lama) tidak perlu diulang di bawah kotak Visi.
const catatanProfil = catatan.filter((c) => c.letak !== "karir" && !(p.visi && bersih(c.teks) === bersih(p.visi)));
const catatanKarir = catatan.filter((c) => c.letak === "karir");

// ---------- Statistik ----------
const sksTotal = totalSksKurikulum(kurikulum, p.lama_studi);
const statistik: ItemStatistik[] = [
	{ label: "Akreditasi", nilai: p.akreditasi, edit: edit.akreditasi },
	{ label: "Gelar Lulusan", nilai: p.gelar, catatan: kepanjanganGelar(p.gelar), edit: edit.gelar },
	{
		label: "Masa Studi",
		nilai: durasiSemester(p.lama_studi),
		catatan: sksTotal ? `${sksTotal} SKS` : durasiTahun(p.lama_studi),
		edit: edit.lama_studi,
	},
];

// ---------- Tab ----------
const adaProfil =
	profilLulusan.length > 0 || kompetensi.length > 0 || keunggulan.length > 0 || !!p.visi || misi.length > 0 || tujuan.length > 0 || catatanProfil.length > 0;
const tabs = [
	adaProfil && { id: "profil", label: "Profil" },
	kurikulum.length > 0 && { id: "kurikulum", label: "Kurikulum" },
	fasilitas.length > 0 && { id: "fasilitas", label: "Fasilitas" },
	(karir.length > 0 || catatanKarir.length > 0) && { id: "karir", label: "Prospek Karir" },
].filter(Boolean) as { id: string; label: string }[];
const pakaiTab = tabs.length > 1;
const tabAktif = tabs[0]?.id;
const panelAttrs = (id: string): HTMLAttributes<"div"> =>
	pakaiTab
		? { id: `panel-${id}`, role: "tabpanel", "aria-labelledby": `tab-${id}`, tabindex: 0, hidden: id !== tabAktif }
		: { id: `panel-${id}` };

const sambutan = kaprodi?.kutipan ? [kaprodi.kutipan] : paragraphs(kaprodi?.tentang);
const ringkasProdi = p.deskripsi_singkat || deskripsi[0] || "";
---

<PageBanner title={p.nama} image={bannerSrc} imageAlt={bannerAlt} breadcrumbs={breadcrumbs} badge={lencana || undefined} />

<PitaStatistik items={statistik} label={`Ringkasan ${s2 ? "program magister" : "program studi"} ${p.nama}`} />

<section class="section tentang" aria-labelledby="tentang-judul">
	<div class="wadah">
		<KepalaSection judul={`Tentang *${singkatan}*`} id="tentang-judul">
			<div class="tentang-isi" {...edit.deskripsi}>
				{deskripsi.map((para) => <p class="lead" set:html={tebal(para)} />)}
			</div>
			{
				p.website && (
					<p class="tautan-situs">
						<a class="btn btn-garis btn-kecil" href={p.website} target="_blank" rel="noopener noreferrer">
							Website resmi Prodi {singkatan}
							<span class="sr-only">(membuka tab baru)</span>
						</a>
					</p>
				)
			}
		</KepalaSection>

		{
			pakaiTab && (
				<div class="tab-grup prodi-tab" role="tablist" aria-label={`Informasi ${s2 ? "" : "Program Studi "}${p.nama}`} data-tabs>
					{tabs.map((t) => (
						<button
							type="button"
							class="tab"
							role="tab"
							id={`tab-${t.id}`}
							aria-controls={`panel-${t.id}`}
							aria-selected={t.id === tabAktif ? "true" : "false"}
							tabindex={t.id === tabAktif ? 0 : -1}
						>
							{t.label}
						</button>
					))}
				</div>
			)
		}

		{
			adaProfil && (
				<div class="panel" {...panelAttrs("profil")}>
					{profilLulusan.length > 0 && (
						<div class="blok">
							<h3 class="judul-sedang">Profil Lulusan</h3>
							<hr class="pemisah" />
							<div class="grid-auto" style="--min: 200px" {...edit.profil_lulusan}>
								{profilLulusan.map((x) => (
									<article class="kartu kartu-kecil">
										<span class="ikon-kotak">
											<Ikon nama={x.ikon} />
										</span>
										<h4>{x.judul}</h4>
										{x.deskripsi && <p>{x.deskripsi}</p>}
									</article>
								))}
							</div>
						</div>
					)}

					{(kompetensi.length > 0 || p.visi || misi.length > 0 || tujuan.length > 0) && (
						<div class="blok dua-kolom">
							{kompetensi.length > 0 && (
								<div class="kolom-utama">
									<h3 class="judul-sedang">Capaian Pembelajaran Lulusan</h3>
									<hr class="pemisah rapat" />
									<ol class="daftar-cpl" {...edit.kompetensi}>
										{kompetensi.map((c, i) => (
											<li>
												<span class="nomor" aria-hidden="true">
													{i + 1}
												</span>
												<div>
													<h4>{c.judul}</h4>
													{c.deskripsi && <p>{c.deskripsi}</p>}
												</div>
											</li>
										))}
									</ol>
								</div>
							)}
							{(p.visi || misi.length > 0 || tujuan.length > 0) && (
								<div class="kolom-samping">
									{p.visi && (
										<div class="kotak-abu">
											<h3 class="label-kotak">Visi</h3>
											<p class="visi" {...edit.visi}>
												{p.visi}
											</p>
										</div>
									)}
									{misi.length > 0 && (
										<div class="kotak-abu">
											<h3 class="label-kotak">Misi</h3>
											<ol class="daftar-angka" {...edit.misi}>
												{misi.map((m, i) => (
													<li>
														<span aria-hidden="true">{i + 1}</span>
														<span>{m}</span>
													</li>
												))}
											</ol>
										</div>
									)}
									{tujuan.length > 0 && (
										<div class="kotak-abu" {...edit.tujuan}>
											<h3 class="label-kotak">Tujuan</h3>
											{tujuan.map((b) =>
												b.type === "p" ? (
													<p class="tujuan-teks">{b.text}</p>
												) : (
													<ul class="daftar-centang">
														{b.items.map((i) => (
															<li>{i}</li>
														))}
													</ul>
												),
											)}
										</div>
									)}
								</div>
							)}
						</div>
					)}

					{keunggulan.length > 0 && (
						<div class="blok">
							<h3 class="judul-sedang">Keunggulan Program</h3>
							<hr class="pemisah" />
							<div class="grid-auto" style="--min: 220px" {...edit.keunggulan}>
								{keunggulan.map((k) => (
									<article class="kartu kartu-kecil">
										<h4>{k.judul}</h4>
										{k.deskripsi && <p>{k.deskripsi}</p>}
									</article>
								))}
							</div>
						</div>
					)}

					{catatanProfil.map((c) => (
						<p class="catatan-kotak">
							{c.judul && <strong>{c.judul}</strong>} {c.teks}
						</p>
					))}
				</div>
			)
		}

		{
			kurikulum.length > 0 && (
				<div class="panel" {...panelAttrs("kurikulum")}>
					<div class="kepala-panel">
						<h3 class="judul-sedang">Struktur Kurikulum</h3>
						{p.kurikulum_pengantar && (
							<p class="pengantar" {...edit.kurikulum_pengantar}>
								{p.kurikulum_pengantar}
							</p>
						)}
					</div>
					<hr class="pemisah" />
					<div class="grid-auto" style="--min: 250px" {...edit.kurikulum}>
						{kurikulum.map((s) => {
							const sks = totalSks(s);
							const mk = mataKuliah(s.mata_kuliah);
							return (
								<article class="kartu semester">
									<div class="semester-kepala">
										<h4>{s.semester}</h4>
										{sks !== null && <span class="pil-abu">{sks} SKS</span>}
									</div>
									{s.fokus && <p class="fokus">{s.fokus}</p>}
									{mk.length > 0 && (
										<ul class="daftar-mk">
											{mk.map((m) => (
												<li>
													<span>{m.nama}</span>
													{m.sks !== null && <span class="sks">{m.sks} SKS</span>}
												</li>
											))}
										</ul>
									)}
								</article>
							);
						})}
					</div>
				</div>
			)
		}

		{
			fasilitas.length > 0 && (
				<div class="panel" {...panelAttrs("fasilitas")}>
					<h3 class="judul-sedang">Fasilitas Pendukung</h3>
					<hr class="pemisah" />
					{p.fasilitas_pengantar && (
						<p class="pengantar jarak-bawah" {...edit.fasilitas_pengantar}>
							{p.fasilitas_pengantar}
						</p>
					)}
					<div class="grid-auto" style="--min: 300px" {...edit.fasilitas}>
						{fasilitas.map((f) => (
							<article class="kartu kartu-kecil">
								<span class="ikon-kotak">
									<Ikon nama={f.ikon} />
								</span>
								<h4>{f.judul}</h4>
								{lines(f.item).length > 0 && (
									<ul class="daftar-pil">
										{lines(f.item).map((i) => (
											<li>{i}</li>
										))}
									</ul>
								)}
							</article>
						))}
					</div>
				</div>
			)
		}

		{
			(karir.length > 0 || catatanKarir.length > 0) && (
				<div class="panel" {...panelAttrs("karir")}>
					<h3 class="judul-sedang">Prospek Karir Lulusan</h3>
					<hr class="pemisah" />
					{p.karir_pengantar && (
						<p class="pengantar jarak-bawah" {...edit.karir_pengantar}>
							{p.karir_pengantar}
						</p>
					)}
					{karir.length > 0 && (
						<div class="grid-auto" style="--min: 200px" {...edit.karir}>
							{karir.map((k) => (
								<article class="kartu-karir">
									<h4>{k.judul}</h4>
									<ul>
										{lines(k.item).map((i) => (
											<li>{i}</li>
										))}
									</ul>
								</article>
							))}
						</div>
					)}
					{catatanKarir.length > 0 && (
						<div class="catatan-karir">
							{catatanKarir.map((c) => (
								<p>
									{c.judul && <strong>{c.judul}</strong>} {c.teks}
								</p>
							))}
						</div>
					)}
				</div>
			)
		}
	</div>
</section>

{
	kaprodi && (
		<section class="kaprodi" aria-labelledby="kaprodi-judul">
			<div class="wadah kaprodi-kepala">
				<JudulSorot text={`Ketua Program Studi *${singkatan}*`} id="kaprodi-judul" />
				<hr class="pemisah rapat" />
			</div>
			<div class="kaprodi-latar">
				<img class="kaprodi-bg" src="/images/slider/slider-iaipi-1.jpg" alt="" loading="lazy" />
				<Ornamen jenis="pola" pudar="tengah" />
				<div class="wadah">
					<div class="kaprodi-kotak">
						<figure class="kaprodi-foto">
							{kaprodi.foto && (
								<img src={kaprodi.foto} alt={kaprodi.fotoAlt || kaprodi.nama} width="316" height="316" loading="lazy" />
							)}
							<figcaption>
								<a class="kaprodi-nama" href={kaprodi.url}>
									{kaprodi.nama}
								</a>
								<span class="kaprodi-jabatan">{kaprodi.jabatan || `Ketua Program Studi ${p.nama}`}</span>
							</figcaption>
						</figure>
						<div class="kaprodi-teks">
							<h3>{kaprodi.kutipan ? "Sambutan Ketua Program Studi" : `${s2 ? "" : "Program Studi "}${p.nama}`}</h3>
							{sambutan.length > 0
								? sambutan.map((t) => <p class="sambutan">{kaprodi.kutipan ? `“${t}”` : t}</p>)
								: ringkasProdi && <p class="sambutan" set:html={tebal(ringkasProdi)} />}
							{kaprodi.pendidikan.length > 0 && (
								<div class="pendidikan">
									<h4>Riwayat Pendidikan</h4>
									<ul>
										{kaprodi.pendidikan.map((x) => (
											<li>{x}</li>
										))}
									</ul>
								</div>
							)}
							<a class="btn btn-garis-putih btn-kecil" href={kaprodi.url}>
								Profil lengkap<span class="sr-only"> {kaprodi.nama}</span>
							</a>
						</div>
					</div>
					<div class="kaprodi-aksi">
						<a class="btn btn-kuning" href="/pmb">
							Daftar ke Prodi {singkatan}
						</a>
					</div>
				</div>
			</div>
		</section>
	)
}

<section class="ajakan" aria-labelledby="ajakan-judul">
	<div class="wadah">
		<JudulSorot text={`Tertarik bergabung dengan *${singkatan}*?`} id="ajakan-judul" />
		{
			p.cta_teks && (
				<p class="lead" {...edit.cta_teks}>
					{/[.!?]$/.test(p.cta_teks.trim()) ? p.cta_teks : `${p.cta_teks}.`}
				</p>
			)
		}
		<div class="ajakan-aksi">
			<a class="btn btn-kuning" href="/pmb">Daftar Sekarang</a>
			<a class="btn btn-krem" href="/kontak">Info Lebih Lanjut</a>
		</div>
	</div>
</section>

<style>
	/* Pola di atas foto latar dibuat lebih samar. */
	.kaprodi-latar :global(.ornamen) {
		color: rgba(255, 255, 255, 0.07);
	}
	/* ---------- Tentang + tab ---------- */
	.tentang {
		padding-block: 80px 62px;
	}
	.tentang-isi {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.tautan-situs {
		margin-top: 22px;
	}
	.prodi-tab {
		margin: 44px 0 0;
	}
	.prodi-tab .tab {
		font-family: var(--font-ui);
		line-height: 1;
	}
	.panel {
		margin-top: 56px;
	}
	.panel:focus-visible {
		outline-offset: 8px;
	}
	.blok + .blok {
		margin-top: 64px;
	}
	.pemisah.rapat {
		margin-bottom: 0;
	}
	.pengantar {
		font-size: 16px;
		line-height: 1.5;
		letter-spacing: 0.3px;
		color: var(--redup);
		max-width: 760px;
	}
	.jarak-bawah {
		margin: -4px 0 28px;
	}
	.kepala-panel {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 48px;
		align-items: flex-end;
		justify-content: space-between;
	}
	.kepala-panel .pengantar {
		max-width: 620px;
	}

	/* Kartu kecil (profil lulusan, fasilitas, keunggulan) */
	.kartu-kecil {
		min-width: 0;
		padding: 22px 20px 26px;
		box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
	}
	.kartu-kecil h4,
	.semester h4 {
		font-family: var(--font-ui);
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
		color: var(--judul);
	}
	.kartu-kecil h4 {
		margin-top: 14px;
	}
	.kartu-kecil .ikon-kotak + h4 {
		margin-top: 18px;
	}
	.kartu-kecil h4:first-child {
		margin-top: 0;
	}
	.kartu-kecil p {
		margin-top: 10px;
		font-size: 15px;
		line-height: 24px;
		letter-spacing: 0.3px;
	}
	.ikon-kotak {
		width: 48px;
		height: 48px;
		flex: none;
		border-radius: 14px;
		background: var(--abu);
		color: var(--hijau);
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.daftar-pil {
		list-style: none;
		margin: 14px 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.daftar-pil li,
	.pil-abu {
		font-family: var(--font-ui);
		font-weight: 700;
		font-size: 13px;
		line-height: 1.4;
		letter-spacing: 0.3px;
		color: var(--hijau);
		background: var(--abu);
		border-radius: 999px;
		padding: 5px 12px;
	}

	/* CPL + visi/misi */
	.dua-kolom {
		display: flex;
		flex-wrap: wrap;
		gap: 48px 56px;
		align-items: flex-start;
	}
	.kolom-utama {
		flex: 2 1 560px;
		min-width: 0;
	}
	.kolom-samping {
		flex: 1 1 340px;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.daftar-cpl {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.daftar-cpl li {
		display: flex;
		gap: 18px;
		padding: 22px 0;
		border-bottom: 1px solid var(--garis);
	}
	.daftar-cpl .nomor {
		flex: none;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: var(--hijau);
		color: var(--putih);
		font-family: var(--font-ui);
		font-weight: 900;
		font-size: 16px;
		display: flex;
		align-items: center;
